/* pages/ai/ai.wxss */
.mode-tabs {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  color: #666;
  transition: all 0.2s;
}

.mode-tab.active {
  background-color: #000;
  color: #fff;
  font-weight: 500;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

.prompt-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 240rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  background-color: #fafafa;
}

.upload-icon {
  font-size: 60rpx;
  color: #ccc;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.ref-image-wrapper {
  position: relative;
  display: inline-block;
}

.ref-image {
  width: 300rpx;
  height: 300rpx;
  border-radius: 12rpx;
}

.remove-ref {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.size-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.size-option {
  padding: 12rpx 24rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.size-option.active {
  border-color: #000;
  color: #000;
  font-weight: 500;
}

.result-card {
  margin-top: 24rpx;
}

.result-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 0;
}
