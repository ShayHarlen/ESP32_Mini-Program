<!--pages/ai/ai.wxml-->
<view class="container">
  <!-- 模式切换 -->
  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'text2img' ? 'active' : ''}}" bindtap="switchMode" data-mode="text2img">
      文生图
    </view>
    <view class="mode-tab {{mode === 'img2img' ? 'active' : ''}}" bindtap="switchMode" data-mode="img2img">
      图生图
    </view>
  </view>

  <!-- 图生图：参考图片上传 -->
  <view wx:if="{{mode === 'img2img'}}" class="card">
    <view class="section-title">参考图片</view>
    <view wx:if="{{!refImagePath}}" class="upload-area" bindtap="chooseRefImage">
      <text class="upload-icon">+</text>
      <text class="upload-text">点击上传参考图片</text>
    </view>
    <view wx:if="{{refImagePath}}" class="ref-image-wrapper">
      <image src="{{refImagePath}}" mode="aspectFit" class="ref-image" />
      <view class="remove-ref" bindtap="removeRefImage">✕</view>
    </view>
  </view>

  <!-- 输入框 -->
  <view class="card">
    <view class="section-title">
      {{mode === 'text2img' ? '描述你想要的图片' : '描述你想要的效果'}}
    </view>
    <textarea
      class="prompt-input"
      placeholder="{{mode === 'text2img' ? '例如：一只可爱的猫咪坐在窗台上' : '例如：把这张图变成素描风格'}}"
      value="{{prompt}}"
      bindinput="onInput"
      maxlength="500"
      auto-height
    />
  </view>

  <!-- 尺寸选择 -->
  <view wx:if="{{mode === 'text2img'}}" class="card">
    <view class="section-title">图片尺寸</view>
    <view class="size-options">
      <view
        wx:for="{{sizes}}"
        wx:key="value"
        class="size-option {{selectedSize === item.value ? 'active' : ''}}"
        bindtap="selectSize"
        data-value="{{item.value}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 生成按钮 -->
  <button
    class="btn-primary"
    bindtap="generate"
    disabled="{{generating || !prompt}}"
  >
    {{generating ? '生成中...' : '生成图片'}}
  </button>

  <!-- 生成结果 -->
  <view wx:if="{{resultImage}}" class="card result-card">
    <view class="section-title">生成结果</view>
    <image src="{{resultImage}}" mode="widthFix" class="result-image" />
    <view class="result-actions">
      <button class="btn-outline" bindtap="saveImage">保存到相册</button>
      <button class="btn-primary" style="margin-top: 16rpx;" bindtap="printResult">编辑并打印</button>
    </view>
  </view>
</view>
