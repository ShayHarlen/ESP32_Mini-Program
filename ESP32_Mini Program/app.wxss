page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: #f5f5f5;
  color: #333;
}

.container {
  padding: 30rpx;
}

.btn-primary {
  background-color: #000;
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-outline {
  background-color: #fff;
  color: #333;
  border: 2rpx solid #ddd;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
}

.btn-disabled {
  background-color: #ccc;
  color: #999;
}

.card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.loading-text {
  color: #999;
  font-size: 28rpx;
  text-align: center;
  padding: 40rpx;
}
